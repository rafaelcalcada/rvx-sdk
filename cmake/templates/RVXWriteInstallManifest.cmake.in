set(_rvx_manifest_path "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/RVXInstallManifest.txt")
set(_rvx_manifest_files ${CMAKE_INSTALL_MANIFEST_FILES} "${_rvx_manifest_path}")
string(REPLACE ";" "\n" _rvx_manifest_content "${_rvx_manifest_files}")
file(WRITE "${_rvx_manifest_path}" "${_rvx_manifest_content}\n")
